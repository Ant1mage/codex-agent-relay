{
  "name": "@relay/relayd",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": "./src/index.ts",
  "bin": {
    "relayd": "./src/serve.ts"
  },
  "scripts": {
    "start": "tsx src/serve.ts",
    "dev": "tsx src/serve.ts",
    "build": "esbuild src/serve.ts --bundle --platform=node --format=esm --target=node22 --outfile=../../out/relayd/serve.js --sourcemap --define:$(node ../../tools/define-version.mjs)"
  },
  "dependencies": {
    "@relay/adapter-antigravity": "workspace:*",
    "@relay/adapter-deepseek": "workspace:*",
    "@relay/adapter-kimi": "workspace:*",
    "@relay/adapter-sdk": "workspace:*",
    "@relay/adapter-zai": "workspace:*",
    "@relay/config": "workspace:*",
    "@relay/core": "workspace:*",
    "@relay/protocol": "workspace:*",
    "@relay/relay-api": "workspace:*"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "tsx": "^4.20.0"
  }
}
