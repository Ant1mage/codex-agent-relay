{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["apps/desktop/src/*"]
    },
    "outDir": "dist",
    "rootDir": "."
  },
  "include": ["packages/**/*.ts", "integrations/**/*.ts", "apps/**/*.ts", "apps/**/*.tsx"],
  "exclude": ["**/*.test.ts", "node_modules", "dist"]
}
