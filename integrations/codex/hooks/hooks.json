{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "relay",
            "tool": "sync_session",
            "input": {
              "session_id": "${session_id}"
            },
            "statusMessage": "Synchronizing Relay session"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__RELAY_SESSION_END_COMMAND__",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
