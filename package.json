{
  "name": "relay",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "deepseek:smoke": "tsx packages/adapters/deepseek/src/smoke.ts",
    "desktop:build": "pnpm --filter @relay/desktop build",
    "desktop:dev": "pnpm --filter @relay/desktop dev",
    "mcp:dev": "tsx packages/mcp/src/stdio.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "electron",
      "esbuild"
    ]
  }
}
