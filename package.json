{
  "name": "relay",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "build": "pnpm build:web && pnpm build:relayd && pnpm build:mcp && pnpm build:menubar",
    "relayd": "tsx apps/relayd/src/serve.ts",
    "seed:demo": "tsx tools/seed-demo.ts",
    "relayd:dev": "tsx watch apps/relayd/src/serve.ts",
    "web:dev": "pnpm --filter @relay/web dev",
    "web:build": "pnpm --filter @relay/web build",
    "menubar:build": "pnpm --filter @relay/menu-bar build",
    "menubar:dev": "pnpm --filter @relay/menu-bar dev",
    "mcp:dev": "tsx packages/mcp/src/stdio.ts",
    "deepseek:smoke": "tsx packages/adapters/deepseek/src/smoke.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:web": "pnpm --filter @relay/web build && pnpm --filter @relay/menu-bar build:panel && rm -rf out/relayd && mkdir -p out/relayd && cp -R apps/web/out out/relayd/web && cp -R apps/menu-bar/out/panel out/relayd/panel",
    "build:relayd": "pnpm --filter @relay/relayd build",
    "build:mcp": "pnpm --filter @relay/mcp build && node tools/link-native-deps.mjs",
    "build:menubar": "pnpm --filter @relay/menu-bar build"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "electron",
      "esbuild"
    ]
  }
}
